# Токен Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# API-ключ OpenRouter (https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Модель для генерации текста (по умолчанию gpt-4o-mini - дешёвая и быстрая)
# Другие варианты: anthropic/claude-3-haiku, meta-llama/llama-3.1-8b-instruct:free
TEXT_MODEL=openai/gpt-4o-mini

# Модель для генерации изображений (DALL-E через OpenRouter)
IMAGE_MODEL=openai/dall-e-3
