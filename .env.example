# Токен Telegram бота (получить у @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Также поддерживаются имена BOT_TOKEN и TELEGRAM_BOT_TOKEN.

# API-ключ OpenRouter (https://openrouter.ai)
# Можно оставить пустым: ручной режим, шаблоны, свои фото и цвета будут работать без AI.
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# Модель для генерации текстов (по умолчанию сильная модель для смысла и структуры)
# Бюджетные варианты: openai/gpt-4o-mini, anthropic/claude-3-haiku
TEXT_MODEL=anthropic/claude-sonnet-4.5

# Модель для генерации изображений через OpenRouter Images
IMAGE_MODEL=google/gemini-2.5-flash-image

# Название бота в заголовках API
BOT_TITLE=Carousel Bot

# Обычно не нужно: на сервере используются системные шрифты.
DOWNLOAD_FONTS=0
